process.roles=broker
node.id=5

controller.quorum.voters=1@sc_kafka_ctl_alpha:9093,2@sc_kafka_ctl_betta:9093
controller.listener.names=CONTROLLER_LIS

listeners=BROKER_LIS://0.0.0.0:9092,BROKER_EXT://0.0.0.0:29092
advertised.listeners=BROKER_LIS://sc_kafka_broker_c:9092,BROKER_EXT://localhost:29094
inter.broker.listener.name=BROKER_LIS
listener.security.protocol.map=CONTROLLER_LIS:PLAINTEXT,BROKER_LIS:PLAINTEXT,BROKER_EXT:PLAINTEXT

num.partitions=3
default.replication.factor=3
min.insync.replicas=2
offsets.topic.replication.factor=3
transaction.state.log.replication.factor=3
transaction.state.log.min.isr=2

log.dirs=/var/lib/kafka/data
